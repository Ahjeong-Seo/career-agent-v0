{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "피드백 재작성 LLM 출력",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentences"],
  "properties": {
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "text", "llm_opinion"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "llm_opinion": { "type": "string" }
        }
      }
    }
  }
}
