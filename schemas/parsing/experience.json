{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "이력서",
  "type": "object",
  "required": [
    "case_id",
    "schema_version",
    "experiences"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "text"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}