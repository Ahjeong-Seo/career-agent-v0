{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "요구사항별 이력서 경험 초안",
  "type": "object",
  "required": [
    "case_id",
    "schema_version",
    "prompt_version",
    "experiences"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "text",
          "years"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "years": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 1
          }
        }
      }
    }
  }
}
