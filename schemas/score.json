{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "채점 결과",
  "description": "스타일별 첨삭 결과의 규칙 기반 채점. 합격 예측이나 총점은 제공하지 않는다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "case_id", "attempt", "attempt_id", "style_id", "items", "issues", "feedback", "needs_revision"],
  "properties": {
    "schema_version": { "const": 2 },
    "case_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "style_id": { "type": "string", "enum": ["achievement", "keyword", "concise"] },
    "needs_revision": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "채점 가능한 체크리스트 항목별 결과. 상태가 충족이면 필수 10점 또는 우대 5점 만점, 그 외에는 0점이다.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["item_id", "status", "reason", "score", "matched_keywords", "missing_keywords", "checks"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["충족", "미충족", "경험 없음"] },
          "reason": { "type": "string", "minLength": 1 },
          "score": {
            "type": "object",
            "additionalProperties": true,
            "required": ["earned", "max"],
            "properties": {
              "earned": { "type": "integer", "minimum": 0, "maximum": 10 },
              "max": { "type": "integer", "enum": [5, 10] }
            }
          },
          "matched_keywords": { "type": "array", "items": { "type": "string" } },
          "missing_keywords": { "type": "array", "items": { "type": "string" } },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["code", "result", "reason"],
              "properties": {
                "code": { "type": "string", "enum": ["NUMERIC_EVIDENCE_PRESENT"] },
                "result": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "품질 경고를 한 곳에 저장하며 각 issue는 checklist item_id를 참조한다.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["item_id", "code", "value", "reason"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "enum": ["UNGROUNDED_NUMBER", "GENERIC_PHRASE", "TEXT_WITHOUT_EXPERIENCE"] },
          "value": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": { "type": "string" }
  }
}
