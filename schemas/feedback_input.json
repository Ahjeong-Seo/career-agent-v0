{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "피드백 재작성 입력",
  "description": "선택한 스타일의 현재 첨삭 문장과 항목별 사용자 의견을 받아 다음 회차를 만든다.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "prompt_version",
    "attempt",
    "style_id",
    "requirements",
    "experiences",
    "revised_cv",
    "user_feedback",
    "old_revised_cv"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
    "style_id": {
      "type": "string",
      "enum": [
        "achievement",
        "keyword",
        "concise",
        "성과 강조형",
        "키워드 맞춤형",
        "간결형"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "required": ["job_title", "company_values", "items"],
      "properties": {
        "job_title": { "type": "string" },
        "company_values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "text", "keywords", "type", "level"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "type": { "type": "string", "enum": ["기술", "경력", "경험", "기타"] },
              "level": { "type": "string", "enum": ["필수", "우대"] }
            }
          }
        }
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["item_id", "text"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revised_cv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/revised_cv_version" }
    },
    "user_feedback": {
      "type": "array",
      "description": "각 원소는 체크리스트 항목 id를 키로 하는 의견 객체다. 의견이 없으면 빈 문자열이다.",
      "items": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "old_revised_cv": {
      "type": "array",
      "description": "이전 회차 첨삭. 첫 피드백이면 빈 목록이다.",
      "items": { "$ref": "#/$defs/revised_cv_version" }
    }
  },
  "$defs": {
    "revised_cv_version": {
      "type": "object",
      "additionalProperties": true,
      "required": ["attempt", "style", "sentences"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
        "style": {
          "type": "string",
          "enum": ["achievement", "keyword", "concise"]
        },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["item_id", "source", "text", "llm_opinion", "user_feedback"],
            "properties": {
              "item_id": { "type": "string", "minLength": 1 },
              "source": { "type": "string" },
              "text": { "type": "string" },
              "llm_opinion": { "type": "string" },
              "user_feedback": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
