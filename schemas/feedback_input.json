{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "이력서 재작성 요청",
  "description": "선택 스타일의 직전 결과와 항목별 사용자 피드백을 담아 재작성을 요청한다.",
  "type": "object",
  "required": ["schema_version", "case_id", "prompt_version", "attempt", "style_id", "requirements", "experiences", "user_feedback", "old_revised_cv", "revised_cv"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
    "style_id": { "type": "string", "enum": ["achievement", "keyword", "concise"] },
    "requirements": {
      "type": "object",
      "required": ["job_title", "company_values", "items"],
      "properties": {
        "job_title": { "type": "string" },
        "company_values": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "text"],
        "properties": { "item_id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
      }
    },
    "user_feedback": { "$ref": "#/$defs/feedback" },
    "old_revised_cv": { "type": "array", "items": { "$ref": "#/$defs/revision" } },
    "revised_cv": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/revision" } }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "text", "keywords", "type", "level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["기술", "경력", "경험", "기타"] },
        "level": { "type": "string", "enum": ["필수", "우대"] }
      }
    },
    "feedback": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "sentence": {
      "type": "object",
      "required": ["item_id", "source", "text", "llm_opinion", "user_feedback"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "llm_opinion": { "type": "string", "minLength": 1 },
        "user_feedback": { "type": "string" }
      }
    },
    "revision": {
      "type": "object",
      "required": ["attempt", "style", "sentences"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
        "style": { "type": "string", "enum": ["achievement", "keyword", "concise"] },
        "sentences": { "type": "array", "items": { "$ref": "#/$defs/sentence" } }
      }
    }
  }
}
